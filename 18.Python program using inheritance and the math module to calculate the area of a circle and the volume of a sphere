import math

# Parent class: Shape
class Shape:
    def __init__(self, radius):
        self.radius = radius

    # Method to calculate area of circle (pi * r^2)
    def calArea(self):
        area = math.pi * (self.radius ** 2)
        return area


# Child class: Sphere (inherits from Shape)
class Sphere(Shape):
    def __init__(self, radius):
        # Call constructor of parent class Shape
        super().__init__(radius)

    # Method to calculate volume of sphere ((4/3) * pi * r^3)
    def calVolume(self):
        volume = (4 / 3) * math.pi * (self.radius ** 3)
        return volume


# Creating an object of the child class Sphere
r = float(input("Enter the radius: "))
s = Sphere(r)

# Displaying area (inherited from Shape) and volume (defined in Sphere)
print(f"Area of Circle with radius {r}: {s.calArea():.2f}")
print(f"Volume of Sphere with radius {r}: {s.calVolume():.2f}")
