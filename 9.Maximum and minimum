# Unsorted list of 10 student names
students = [
    "Alex", "Jordan", "Taylor", "Morgan", "Sam", 
    "Chris", "Pat", "Riley", "Jamie", "Casey"
]

# Unsorted list of unique marks
marks = [85, 92, 78, 90, 64, 88, 73, 95, 81, 69]

# Assuming the first element is both max and min initially
max_mark = marks[0]
min_mark = marks[0]

max_index = 0
min_index = 0

# Loop through the list to find max and min marks
for i in range(1, len(marks)):
    # Check for maximum mark
    if marks[i] > max_mark:
        max_mark = marks[i]
        max_index = i
        
    # Check for minimum mark
    if marks[i] < min_mark:
        min_mark = marks[i]
        min_index = i

# Displaying the results using the saved index values
print("Highest Marks:")
print(students[max_index], "got the highest mark of", max_mark)

print("\nLowest Marks:")
print(students[min_index], "got the lowest mark of", min_mark)
